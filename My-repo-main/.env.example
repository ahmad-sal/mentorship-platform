# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_ANON_KEY: Public anon key from Supabase Settings -> API
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdzZ3pneGlnc3J1ZWVqd3B4dG1xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc1MzQ5MzksImV4cCI6MjEwMzExMDkzOX0.tR6qSPR_o2FF7lDjSuAwmoI-K97tS9bcOqddPqRfulA"

# Required for all server-side database writes because students use Express sessions,
# not Supabase Auth sessions. Without this key, Supabase RLS blocks those writes.
# Get it from Supabase Dashboard -> Settings -> API -> service_role (keep this secret!).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdzZ3pneGlnc3J1ZWVqd3B4dG1xIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzUzNDkzOSwiZXhwIjoyMTAzMTEwOTM5fQ.7XyKtBHDuWvfvkXMmW4y_C9lfhbvSkrD1o2DnTA4mts"